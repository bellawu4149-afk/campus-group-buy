.feedback-page { padding-bottom: 60rpx; }.feedback-hero { padding: 20rpx 8rpx 34rpx; }.feedback-icon { margin-bottom: 14rpx; font-size: 50rpx; }.feedback-card { position: relative; margin-bottom: 22rpx; padding: 30rpx; }.question { margin-bottom: 24rpx; font-weight: 700; }.question text { color: #d96c47; }.question-tip { position: absolute; right: 30rpx; top: 32rpx; color: #aaa198; font-size: 21rpx; }.stars { display: flex; justify-content: space-between; padding: 4rpx 18rpx; }.star { color: #ded9d3; font-size: 62rpx; }.star.active { color: #f0a54b; }.hint { margin-top: 10rpx; color: #aaa198; text-align: center; font-size: 22rpx; }.option { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0ece7; }.option:last-child { border-bottom: 0; }.option radio,.option checkbox { transform: scale(.84); margin-right: 10rpx; }.feedback-card textarea { width: 100%; min-height: 190rpx; padding: 22rpx; border-radius: 18rpx; background: #f8f6f3; box-sizing: border-box; font-size: 26rpx; line-height: 1.6; }.count { margin-top: 10rpx; color: #aaa198; text-align: right; font-size: 21rpx; }.saved-tip { margin-top: 20rpx; color: #67a477; text-align: center; font-size: 23rpx; }
