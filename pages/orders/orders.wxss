.orders-head { margin-bottom: 28rpx; }.order-card { margin-bottom: 24rpx; padding: 30rpx; }.order-head { display: flex; justify-content: space-between; padding-bottom: 24rpx; border-bottom: 1rpx solid #f0ece7; }.group-name { font-size: 31rpx; font-weight: 700; }.order-time { margin-top: 7rpx; color: #a59c94; font-size: 21rpx; }.status { height: 46rpx; padding: 0 18rpx; border-radius: 999rpx; color: #b45c3f; background: #fae8dd; line-height: 46rpx; font-size: 22rpx; }.join-number-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 18rpx 20rpx; border-radius: 16rpx; color: #8c786c; background: #fff4eb; font-size: 24rpx; }.join-number { color: #c75f3d; font-size: 38rpx; font-weight: 800; letter-spacing: 5rpx; }.goods-line { display: flex; justify-content: space-between; padding-top: 18rpx; color: #5a524b; font-size: 25rpx; }.contact { margin-top: 22rpx; padding: 20rpx; border-radius: 16rpx; color: #81776f; background: #f8f6f3; font-size: 23rpx; line-height: 1.7; }.order-total { margin-top: 24rpx; text-align: right; color: #8f8780; }.order-total text { color: #d35632; font-size: 32rpx; font-weight: 700; }.empty-icon { margin-bottom: 20rpx; font-size: 80rpx; }.empty-title { margin-bottom: 10rpx; color: #423b35; font-size: 32rpx; font-weight: 700; }.shop-button { width: 230rpx; margin: 34rpx auto 0; color: #fff; border-radius: 999rpx; background: #d96c47; line-height: 76rpx; font-size: 27rpx; }
.history-notice { margin: -10rpx 0 24rpx; padding: 18rpx 22rpx; border-radius: 14rpx; color: #8b776c; background: #fff4eb; font-size: 22rpx; line-height: 1.6; }.state-card { padding: 40rpx 28rpx; color: #81776f; text-align: center; }.retry-button { width: 220rpx; margin: 28rpx auto 0; color: #fff; border-radius: 999rpx; background: #d96c47; font-size: 25rpx; }
