.clone-page { padding-bottom: 72rpx; }.loading,.error { padding: 90rpx 32rpx; color: #8a8178; text-align: center; }.retry { width: 220rpx; margin-top: 28rpx; border-radius: 999rpx; color: #fff; background: #d96c47; font-size: 26rpx; }
.source-card,.form-card { margin-bottom: 22rpx; padding: 30rpx; }.field-label { color: #978d84; font-size: 23rpx; }.source-name { margin-top: 10rpx; font-size: 34rpx; font-weight: 700; }.form-card input { height: 88rpx; margin-top: 16rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f8f6f3; box-sizing: border-box; font-size: 28rpx; }
.section-title { margin: 42rpx 4rpx 18rpx; font-size: 32rpx; font-weight: 700; }.products { padding: 6rpx 28rpx; }.product-row { display: flex; align-items: center; justify-content: space-between; min-height: 108rpx; border-bottom: 1rpx solid #f0ece7; }.product-row:last-child { border-bottom: 0; }.product-name { font-weight: 600; }.product-status { margin-top: 6rpx; color: #ad7762; font-size: 21rpx; }.product-price { color: #d35632; font-size: 29rpx; font-weight: 700; }.empty-row { padding: 52rpx 20rpx; color: #a09890; text-align: center; }.copy-note { margin: 22rpx 8rpx 0; color: #928981; font-size: 23rpx; line-height: 1.6; }.create-button { margin-top: 32rpx; }
