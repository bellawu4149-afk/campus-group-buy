.source-page { padding-bottom: 72rpx; }.intro { padding: 14rpx 4rpx 30rpx; }.page-title { font-size: 42rpx; font-weight: 800; }.page-subtitle { margin-top: 8rpx; color: #978d84; font-size: 24rpx; }.loading,.error { padding: 90rpx 32rpx; color: #8a8178; text-align: center; }.retry { width: 220rpx; margin-top: 28rpx; border-radius: 999rpx; color: #fff; background: #d96c47; font-size: 26rpx; }
.source-card { display: flex; align-items: center; margin-bottom: 20rpx; padding: 30rpx; }.source-main { flex: 1; min-width: 0; }.source-name { font-size: 31rpx; font-weight: 700; }.source-meta { margin-top: 12rpx; color: #956c58; font-size: 24rpx; }.created-at { margin-top: 8rpx; color: #aaa199; font-size: 21rpx; }.arrow { margin-left: 20rpx; color: #ba765c; font-size: 46rpx; }.empty { padding: 90rpx 30rpx; color: #999088; text-align: center; }
