.detail-page { padding-bottom: 72rpx; }.loading,.error { padding: 90rpx 32rpx; color: #8a8178; text-align: center; }.retry { width: 220rpx; margin-top: 28rpx; border-radius: 999rpx; color: #fff; background: #d96c47; font-size: 26rpx; }
.detail-hero { position: relative; padding: 34rpx; color: #fff; background: linear-gradient(135deg, #765044, #b36d52); }.detail-label { color: rgba(255,255,255,.72); font-size: 22rpx; }.follow-no { margin-top: 8rpx; font-size: 54rpx; font-weight: 800; letter-spacing: 5rpx; }.status { position: absolute; top: 34rpx; right: 34rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 22rpx; }
.info-card { margin-top: 24rpx; padding: 18rpx 28rpx; }.info-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0ece7; }.info-row:last-child { border-bottom: 0; }.info-row text:first-child { flex: none; color: #918880; }.info-row text:last-child { text-align: right; }.long-value { word-break: break-all; font-size: 23rpx; }
.section-title { margin: 42rpx 4rpx 18rpx; font-size: 32rpx; font-weight: 700; }.items-card { padding: 8rpx 28rpx; }.item-row { display: grid; grid-template-columns: 1fr auto; gap: 9rpx 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f0ece7; }.item-name { font-weight: 600; }.item-calc { grid-column: 1; color: #958c84; font-size: 23rpx; }.item-subtotal { grid-column: 2; grid-row: 1 / 3; align-self: center; color: #d35632; font-weight: 700; }.total-row { display: flex; justify-content: space-between; padding: 28rpx 0; font-weight: 700; }.total-row text:last-child { color: #d35632; font-size: 36rpx; }.empty-row { padding: 50rpx 20rpx; color: #a09890; text-align: center; }
