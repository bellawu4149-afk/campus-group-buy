.order-page { padding-bottom: 64rpx; }.notice { margin-bottom: 22rpx; padding: 20rpx 24rpx; border-radius: 18rpx; color: #8c644f; background: #f9e9dc; font-size: 23rpx; }.block { margin-bottom: 24rpx; padding: 30rpx; }.block-title { margin-bottom: 16rpx; font-size: 31rpx; font-weight: 700; }.required { color: #d96c47; }.order-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0ece7; }.item-emoji { width: 72rpx; height: 72rpx; margin-right: 18rpx; border-radius: 18rpx; background: #fff3e4; text-align: center; line-height: 72rpx; font-size: 39rpx; }.item-main { flex: 1; }.item-meta { margin-top: 6rpx; color: #9c938a; font-size: 22rpx; }.total-row { display: flex; justify-content: space-between; padding-top: 24rpx; color: #8f8780; }.total-price { margin-left: 10rpx; color: #d35632; font-size: 34rpx; font-weight: 700; }.field { padding: 22rpx 0; border-bottom: 1rpx solid #f0ece7; }.field:last-child { border-bottom: 0; }.label { margin-bottom: 15rpx; font-weight: 600; }.label text { color: #d96c47; }.field input,.field textarea { width: 100%; color: #39332e; font-size: 28rpx; }.field textarea { min-height: 74rpx; line-height: 1.5; }.pickup-options { display: flex; gap: 20rpx; }.pickup-option { flex: 1; padding: 22rpx 0; border: 2rpx solid #ece5de; border-radius: 18rpx; color: #746961; text-align: center; }.pickup-option.active { border-color: #d96c47; color: #c25d3c; background: #fff2e9; font-weight: 700; }.pickup-input-row { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; }.pickup-input-row input,.pickup-block textarea { flex: 1; padding: 20rpx 22rpx; border-radius: 16rpx; background: #f8f6f3; box-sizing: border-box; font-size: 27rpx; }.pickup-block textarea { width: 100%; min-height: 110rpx; margin-top: 24rpx; line-height: 1.5; }.pickup-hint { margin-top: 12rpx; color: #a59c94; font-size: 22rpx; }.pickup { display: flex; align-items: center; padding: 25rpx 30rpx; }.pickup-icon { margin-right: 20rpx; font-size: 38rpx; }.pickup-label { margin-bottom: 4rpx; color: #9b928a; font-size: 22rpx; }.submit { margin-top: 34rpx; }
