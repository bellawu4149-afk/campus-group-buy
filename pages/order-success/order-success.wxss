.success-page { padding-top: 58rpx; text-align: center; }.success-icon { width: 104rpx; height: 104rpx; margin: 0 auto 24rpx; border-radius: 50%; color: #fff; background: #62aa78; font-size: 58rpx; font-weight: 700; line-height: 104rpx; box-shadow: 0 12rpx 30rpx rgba(70,148,94,.2); }.success-title { font-size: 40rpx; font-weight: 800; }.success-subtitle { margin-top: 10rpx; color: #9a9189; font-size: 23rpx; }.number-card { margin: 42rpx 0 24rpx; padding: 38rpx 30rpx; border: 2rpx solid #f1c5ad; border-radius: 30rpx; background: linear-gradient(145deg,#fff7ef,#ffebdd); }.number-label { color: #9b6d57; font-size: 25rpx; }.join-number { margin: 12rpx 0; color: #c75f3d; font-size: 86rpx; font-weight: 900; letter-spacing: 14rpx; line-height: 1.25; }.number-tip { color: #a88675; font-size: 22rpx; }.summary-card { margin-bottom: 34rpx; padding: 16rpx 30rpx; text-align: left; }.summary-row { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f0ece7; color: #91877f; font-size: 25rpx; }.summary-row:last-child { border-bottom: 0; }.summary-row text:last-child { max-width: 430rpx; color: #403933; text-align: right; }.summary-row .amount { color: #d35632; font-size: 31rpx; font-weight: 700; }.secondary-button { margin-top: 18rpx; color: #746961; border-radius: 999rpx; background: transparent; font-size: 28rpx; line-height: 82rpx; }
