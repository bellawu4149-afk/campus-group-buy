.leader-page { padding-bottom: 72rpx; }
.loading,.error { padding: 90rpx 32rpx; color: #8a8178; text-align: center; }
.retry { width: 220rpx; margin-top: 28rpx; border-radius: 999rpx; color: #fff; background: #d96c47; font-size: 26rpx; }
.leader-hero { position: relative; padding: 38rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(135deg, #67483d, #b26b50); box-shadow: 0 16rpx 42rpx rgba(83, 53, 43, .18); }
.eyebrow { color: rgba(255,255,255,.72); font-size: 22rpx; letter-spacing: 4rpx; }.hero-name { max-width: 75%; margin-top: 16rpx; font-size: 40rpx; font-weight: 700; }.status-pill { position: absolute; top: 34rpx; right: 34rpx; padding: 9rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.18); font-size: 22rpx; }
.leader-actions { margin-top: 22rpx; padding: 24rpx; }.close-button,.export-button { border-radius: 18rpx; font-size: 28rpx; font-weight: 700; line-height: 82rpx; }.close-button { color: #9b4f37; background: #fff0e7; }.export-button { color: #fff; background: #5f765e; }.close-button[disabled],.export-button[disabled] { opacity: .65; }.export-hint { margin-top: 14rpx; color: #938981; text-align: center; font-size: 22rpx; }
.section-title { margin: 44rpx 4rpx 18rpx; font-size: 32rpx; font-weight: 700; }
.summary-grid { display: flex; padding: 30rpx 10rpx; }.summary-item { flex: 1; text-align: center; border-right: 1rpx solid #eee8e2; }.summary-item:last-child { border-right: 0; }.summary-number { font-size: 40rpx; font-weight: 800; }.summary-number.amount { color: #d35632; font-size: 33rpx; }.summary-label { margin-top: 9rpx; color: #988f87; font-size: 21rpx; }
.list-card,.pickup-card { padding: 8rpx 28rpx; }.data-row { display: flex; align-items: center; min-height: 104rpx; border-bottom: 1rpx solid #f0ece7; }.data-row:last-child { border-bottom: 0; }.row-main { flex: 1; min-width: 0; }.row-meta { margin: 0 24rpx; color: #8e857d; font-size: 24rpx; }.row-amount { color: #d35632; font-weight: 700; }
.group-label { margin-top: 24rpx; color: #a36c54; font-size: 23rpx; font-weight: 700; }.pickup-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #f2eee9; }.pickup-row text:last-child { color: #8c837b; }.empty-row { padding: 46rpx 20rpx; color: #a09890; text-align: center; }
.order-card { margin-bottom: 20rpx; padding: 28rpx; }.order-head,.order-foot,.info-row { display: flex; justify-content: space-between; }.order-head { align-items: center; margin-bottom: 20rpx; }.follow-no { font-size: 31rpx; font-weight: 800; }.order-status { padding: 6rpx 14rpx; border-radius: 999rpx; color: #9b654c; background: #fff0e5; font-size: 21rpx; }.info-row { padding: 8rpx 0; color: #8f8780; font-size: 24rpx; }.info-row text:last-child { max-width: 68%; color: #3c3631; text-align: right; }.order-foot { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0ece7; color: #999088; font-size: 23rpx; }.order-price { color: #d35632; font-size: 28rpx; font-weight: 700; }
