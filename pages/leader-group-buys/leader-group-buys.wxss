.groups-page { padding-bottom: 72rpx; }.page-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }.page-title { font-size: 44rpx; font-weight: 800; }.page-subtitle { margin-top: 6rpx; color: #978d84; font-size: 23rpx; }.add-button { width: 76rpx; height: 76rpx; margin: 0; padding: 0; border-radius: 22rpx; color: #fff; background: #d96c47; line-height: 72rpx; font-size: 48rpx; font-weight: 300; box-shadow: 0 10rpx 24rpx rgba(217,108,71,.22); }.loading,.error { padding: 90rpx 32rpx; color: #8a8178; text-align: center; }.retry { width: 220rpx; margin-top: 28rpx; border-radius: 999rpx; color: #fff; background: #d96c47; font-size: 26rpx; }
.group-card { margin-bottom: 22rpx; padding: 30rpx; }.card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }.group-name { flex: 1; font-size: 32rpx; font-weight: 700; }.status { flex: none; padding: 7rpx 15rpx; border-radius: 999rpx; font-size: 21rpx; }.status-active { color: #477b55; background: #e9f5eb; }.status-closed { color: #8b7165; background: #efe9e5; }.metrics { display: flex; margin-top: 28rpx; padding: 24rpx 0; border-top: 1rpx solid #f0ece7; border-bottom: 1rpx solid #f0ece7; }.metrics view { flex: 1; display: flex; flex-direction: column; }.metrics text { font-size: 30rpx; font-weight: 750; }.metrics label { margin-top: 6rpx; color: #9b928a; font-size: 21rpx; }.created-at { display: flex; justify-content: space-between; margin-top: 20rpx; color: #aaa199; font-size: 21rpx; }.created-at text { color: #7f746c; font-size: 28rpx; }.empty { padding: 90rpx 30rpx; color: #999088; text-align: center; }
