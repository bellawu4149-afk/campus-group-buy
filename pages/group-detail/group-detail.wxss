.detail-page { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }.detail-hero { padding: 44rpx 36rpx 38rpx; color: #fff; background: linear-gradient(150deg, #cb6646, #e79969); }.status-pill { display: inline-block; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.2); font-size: 22rpx; }.detail-title { margin-top: 26rpx; font-size: 45rpx; font-weight: 800; }.detail-desc { margin-top: 10rpx; color: rgba(255,255,255,.8); }.time-grid { display: flex; margin-top: 34rpx; padding: 26rpx 0; border-top: 1rpx solid rgba(255,255,255,.2); border-bottom: 1rpx solid rgba(255,255,255,.2); }.time-item { flex: 1; display: flex; flex-direction: column; font-weight: 600; }.time-item + .time-item { padding-left: 28rpx; border-left: 1rpx solid rgba(255,255,255,.2); }.time-label { margin-bottom: 8rpx; color: rgba(255,255,255,.68); font-size: 21rpx; font-weight: 400; }.place { margin-top: 24rpx; font-size: 24rpx; }.list-head { padding: 40rpx 32rpx 20rpx; }.product-list { padding: 0 32rpx; }.product-card { display: flex; overflow: hidden; margin-bottom: 22rpx; }.product-cover { position: relative; flex: 0 0 184rpx; display: flex; align-items: center; justify-content: center; min-height: 204rpx; background: linear-gradient(145deg,#fff2e2,#f7dfc8); font-size: 76rpx; }.hot-tag { position: absolute; left: 0; top: 0; padding: 7rpx 12rpx; border-radius: 0 0 14rpx; color: #fff; background: #e27a43; font-size: 18rpx; }.product-body { flex: 1; min-width: 0; padding: 24rpx; }.product-name { font-weight: 700; }.product-desc { height: 64rpx; margin-top: 8rpx; color: #9a9189; font-size: 22rpx; line-height: 32rpx; }.product-bottom { display: flex; justify-content: space-between; align-items: center; min-width: 0; margin-top: 12rpx; }.product-bottom .price { flex-shrink: 0; }.stepper { flex: 0 0 174rpx; display: flex; align-items: center; justify-content: space-between; width: 174rpx; }.step-btn { flex: 0 0 54rpx; width: 54rpx; min-width: 54rpx; max-width: 54rpx; height: 54rpx; margin: 0; padding: 0; border-radius: 50%; box-sizing: border-box; line-height: 54rpx; font-size: 31rpx; }.quantity { flex: 0 0 42rpx; width: 42rpx; text-align: center; line-height: 54rpx; }.plus { color: #fff; background: #d96c47; }.minus { color: #665d56; background: #f2eee9; }.step-btn[disabled] { color: #c7c1ba; background: #f5f3f0; }.cart-space { height: 20rpx; }.cart-bar { position: fixed; z-index: 5; left: 24rpx; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; padding: 14rpx 14rpx 14rpx 26rpx; border-radius: 28rpx; background: #2f2b27; color: #fff; box-shadow: 0 16rpx 40rpx rgba(0,0,0,.2); }.cart-summary { flex: 1; display: flex; align-items: center; gap: 22rpx; color: #d9d3ce; font-size: 22rpx; }.cart-count { display: inline-block; min-width: 34rpx; height: 34rpx; border-radius: 50%; color: #fff; background: #d96c47; text-align: center; line-height: 34rpx; }.cart-total text { color: #fff; font-size: 31rpx; font-weight: 700; }.checkout { width: 190rpx; color: #fff; border-radius: 20rpx; background: #d96c47; line-height: 78rpx; font-size: 28rpx; font-weight: 600; }.checkout[disabled] { color: #a7a29e; background: #5a5551; }
.management-card { margin: 24rpx 32rpx 0; padding: 24rpx 26rpx; border: 1rpx solid #f1d5c3; border-radius: 22rpx; background: #fff9f3; box-shadow: 0 8rpx 24rpx rgba(166,91,55,.08); }.management-top { display: flex; align-items: center; justify-content: space-between; }.leader-badge { padding: 7rpx 16rpx; border-radius: 999rpx; color: #fff; background: #d96c47; font-size: 21rpx; font-weight: 700; }.management-caption { color: #a58776; font-size: 21rpx; }.management-body { display: flex; align-items: center; margin-top: 20rpx; }.metric { min-width: 130rpx; margin-right: 28rpx; }.metric-value { color: #3f352f; font-size: 34rpx; font-weight: 800; }.metric-value.amount { color: #c95837; font-size: 30rpx; }.metric-label { margin-top: 4rpx; color: #9b8d84; font-size: 20rpx; }.management-link { margin-left: auto; padding: 16rpx 0 16rpx 18rpx; color: #c75f3d; font-size: 24rpx; font-weight: 700; }.management-link text { margin-left: 4rpx; }.management-unavailable { margin: 18rpx 32rpx 0; color: #a48f82; font-size: 21rpx; }
