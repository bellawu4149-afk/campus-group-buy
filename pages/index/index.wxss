.home-page { padding: 24rpx 30rpx 52rpx; background: #f6f5f0; }
.plaza-header { position: relative; overflow: hidden; padding: 40rpx 34rpx 36rpx; border-radius: 32rpx; background: #e9eddf; }
.header-eyebrow { position: relative; z-index: 1; color: #6c775c; font-size: 23rpx; letter-spacing: 2rpx; }
.plaza-title { position: relative; z-index: 1; margin-top: 14rpx; color: #293c31; font-size: 49rpx; font-weight: 800; line-height: 1.4; }
.school-pill { position: relative; z-index: 1; display: inline-flex; align-items: center; margin-top: 24rpx; padding: 12rpx 20rpx; border-radius: 24rpx; color: #405443; background: rgba(255,255,255,.76); font-size: 25rpx; }
.location-icon { margin-right: 8rpx; font-size: 24rpx; }
.header-orbit { position: absolute; border: 2rpx solid rgba(113,139,94,.15); border-radius: 50%; }
.orbit-one { width: 270rpx; height: 270rpx; right: -100rpx; top: -80rpx; }
.orbit-two { width: 200rpx; height: 200rpx; right: -65rpx; top: -45rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin: 42rpx 4rpx 24rpx; }
.section-title { color: #2c3d33; font-size: 34rpx; font-weight: 700; }
.section-note { margin-top: 8rpx; color: #90958b; font-size: 23rpx; }
.group-count { flex-shrink: 0; margin-left: 12rpx; padding: 8rpx 14rpx; border-radius: 16rpx; color: #667653; background: #e8ecdf; font-size: 21rpx; }
.group-card { overflow: hidden; margin-bottom: 28rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(51,66,41,.06); }
.group-card-pressed { opacity: .88; }
.cover-wrap { position: relative; height: 324rpx; background: #ece9dd; }
.group-cover { display: block; width: 100%; height: 100%; }
.status-badge { position: absolute; left: 24rpx; top: 24rpx; display: flex; align-items: center; padding: 10rpx 18rpx; border-radius: 24rpx; color: #365b42; background: rgba(255,255,255,.94); font-size: 22rpx; font-weight: 600; }
.status-dot { width: 10rpx; height: 10rpx; margin-right: 10rpx; border-radius: 50%; background: #61936b; }
.group-content { padding: 26rpx 28rpx 24rpx; }
.group-title { color: #2f3a31; font-size: 35rpx; font-weight: 700; line-height: 1.5; overflow-wrap: break-word; word-break: break-all; }
.card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.campus-label { padding: 7rpx 14rpx; border-radius: 10rpx; color: #8d7959; background: #f6f1e7; font-size: 21rpx; }
.enter-group { display: flex; align-items: center; color: #4e6c48; font-size: 25rpx; font-weight: 600; }
.enter-arrow { margin-left: 14rpx; font-size: 32rpx; }
.state-card { padding: 60rpx 32rpx; border: 2rpx solid #eeeee5; border-radius: 30rpx; background: #fff; text-align: center; }
.state-symbol { display: flex; justify-content: center; align-items: center; width: 108rpx; height: 108rpx; margin: 0 auto 26rpx; border-radius: 36rpx; color: #7e9366; background: #edf0e4; font-size: 55rpx; }
.state-title { color: #3c4c3d; font-size: 30rpx; font-weight: 600; }
.state-copy { max-width: 490rpx; margin: 16rpx auto 0; color: #92978c; font-size: 25rpx; line-height: 1.8; }
.retry { width: 240rpx; margin: 30rpx auto 0; border-radius: 24rpx; color: #fff; background: #657e53; font-size: 26rpx; line-height: 80rpx; }
.empty-state { padding-top: 76rpx; padding-bottom: 76rpx; }
.list-end { padding: 10rpx 0 12rpx; text-align: center; color: #a2a69b; font-size: 22rpx; letter-spacing: 1rpx; }
